# ==========================================
# LexPilot Environment Variables Example
# ==========================================

# ------------------------------------------
# Express (Node) API Settings
# ------------------------------------------
# Port for the Express server to run on
PORT=3000

# Secret key for JWT authentication
JWT_SECRET=super-secret-lexpilot-key

# URL where the Express API can reach the FastAPI service
FASTAPI_URL=http://localhost:8000

# ------------------------------------------
# FastAPI (Python) Settings
# ------------------------------------------
# Port for the FastAPI server to run on (typically set via uvicorn command)
# Example: uvicorn backend_fastapi.main:app --port 8000

# API key for Google Gemini (LangChain integration)
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------
# Shared Settings (Used by both services)
# ------------------------------------------
# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/lexpilot

# Shared secret used to authenticate internal requests from Express to FastAPI
INTERNAL_SECRET=internal-secret-token
